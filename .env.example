# ============================================================================
# 必填：資料庫連線字串（PostgreSQL）。見 README「資料庫設定」章節，可用
# Vercel Marketplace 上的 Neon / Supabase / Prisma Postgres 建立，或用
# `npx prisma dev` 在本機啟動一個免帳號的開發用 Postgres。
# ============================================================================

DATABASE_URL=

# ============================================================================
# 必填：Google 帳號登入（Auth.js / next-auth）。見 README「Google 登入設定」
# 章節，內含非工程師也能照著做的 Google Cloud Console 設定步驟。
# 未設定時，首頁會清楚顯示「尚未設定 Google 登入」，而不是空白畫面或錯誤。
# ============================================================================

# 用來加密登入 session 的密鑰，用指令 `npx auth secret` 產生（會自動寫入
# .env.local），或自行用 `openssl rand -base64 32` 產生。
AUTH_SECRET=

# Google OAuth 2.0 用戶端 ID／密鑰（Google Cloud Console → API 和服務 →
# 憑證）。這組密鑰只用於伺服器端與 Google 交換登入結果，絕不會傳到瀏覽器。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 選填：正式站網址（例如 https://newskill.example.com）。用於 Auth.js 的
# callback URL 組裝與下面的同源保護；本機開發不需要設定。
# AUTH_URL=

# ============================================================================
# 選填：舊版 data/sources.json 匯入權限。只有這裡指定 email 的使用者，登入後
# 才會在「設定」頁看到「匯入舊版新聞來源」的提示；其他人登入不會看到，也不會
# 自動匯入任何東西。見 README「匯入舊版資料」章節。
# ============================================================================

LEGACY_OWNER_EMAIL=

# ============================================================================
# 選填：設定後可讓「翻譯成繁體中文」功能穩定運作（見 README「翻譯功能」章節）
# 不設定的話，網站仍可運作，但會使用免費、無需註冊的 MyMemory 翻譯，配額很小，
# 常常會翻譯失敗而顯示英文原文。
# ============================================================================

AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# ============================================================================
# 選填：學術／文獻類 connector（Europe PMC、PubMed、Crossref）使用的公開身份
# 識別資訊，用於「精選來源」「搜尋全部來源」「自行新增」輸入 DOI/ISSN/期刊名稱
# 時查詢對應的官方 API。三個 provider 都不需要金鑰即可運作；下面的變數是選填、
# 用來換取更穩定的服務等級（NCBI 建議設定 email/tool 以提高限流門檻，Crossref
# 建議設定 mailto 以進入「polite pool」）。這些值只會用在伺服器端組出請求網址，
# 絕不會傳到瀏覽器，也絕不會存進 Source.connectorConfig（那裡只能存公開設定）。
# 適用所有職業領域，不是醫療專屬——Crossref 尤其可用於 health、education、
# architecture、tech、finance、law 等任何領域的 DOI/ISSN 查詢。
# ============================================================================

# NCBI（PubMed）：官方文件 https://www.ncbi.nlm.nih.gov/home/develop/api/
# 沒有 API Key 時，全站對 PubMed 的請求會被限制在每秒最多 3 次；有 Key 時
# 上限較高，但程式仍會維持保守的節流，不會逐篇文章各發一次請求。
NCBI_API_KEY=
NCBI_TOOL=newskill
NCBI_EMAIL=

# Crossref：官方文件 https://www.crossref.org/documentation/retrieve-metadata/rest-api/
CROSSREF_MAILTO=

# ============================================================================
# 選填：若要用排程服務（例如 Vercel Cron、外部 cron job）定期呼叫
# POST /api/refresh 觸發全站來源重新整理，設定這組密鑰；排程呼叫時在請求標頭
# 帶 `Authorization: Bearer <CRON_SECRET>`。未設定時，/api/refresh 一律要求
# 使用者先登入才能呼叫，不接受任何匿名請求；這組密鑰只會在伺服器端比對，
# 絕不會傳到瀏覽器。
# ============================================================================

CRON_SECRET=

# ============================================================================
# 已完全移除：舊版「管理者密碼」（ADMIN_PASSWORD）登入機制已被上面的 Google
# 登入取代，相關程式碼、API 路由、環境變數都已移除，且不會再重新引入。新增/
# 取消追蹤來源、新增/刪除分類等功能現在只需要使用者本人登入即可使用。
#
# GITHUB_TOKEN / GITHUB_REPO 也已不再使用：多使用者升級後，一般使用者的訂閱
# 不再經由「寫回 GitHub 上的 data/sources.json」這個機制儲存，改存在資料庫裡
# （見上方 DATABASE_URL）。data/sources.json 現在只作為舊資料一次性匯入的
# 來源（見 README「匯入舊版資料」）與 data/catalog/*.json 精選來源目錄的
# 種子資料參考。
# ============================================================================

# ============================================================================
# 選填但建議設定：新增/刪除、登出等管理 API 的同源（CSRF）保護會比對請求的
# Origin，優先使用這裡設定的網址；沒設定時會退回 Vercel 自動提供的
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL（多數情況已經夠用）。若你的正式站
# 用自訂網域，或想確保萬無一失，請設成你網站的完整網址（見 README「同源保護 /
# CSRF」章節）。本機開發固定允許 http://localhost:3000，不受這個變數影響。
# ============================================================================

NEXT_PUBLIC_SITE_URL=
